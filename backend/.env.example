# ============ 复制为 .env 后按需修改 ============

# 应用
APP_NAME=FaceID 人脸识别系统
APP_ENV=dev
API_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

# 跨域（前端 Vite 地址）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:115,http://127.0.0.1:115

# 存储根目录（相对 backend/ 或绝对路径）
STORAGE_DIR=storage

# ---------- 矢量数据库 ----------
# chroma = ChromaDB 持久化客户端（默认）
# local  = 内置 NumPy + SQLite 精确检索（零依赖兜底）
VECTOR_BACKEND=chroma
VECTOR_COLLECTION=face_embeddings

# ---------- 人脸引擎 ----------
# arcface = ArcFace(ONNX) 真模型
# mock    = 确定性伪特征（离线单元测试用）
FACE_ENGINE=arcface
FACE_MODEL_NAME=arcface_r50
FACE_EMBEDDING_DIM=512

# ---------- 识别阈值（核心：保证准确率 >= 70%） ----------
# 余弦相似度阈值：同人相似度 > DM_THRESHOLD 视为命中
# 0.40 是 ArcFace 在 LFW 级别数据上的常用工作点
FACE_MATCH_COSINE_THRESHOLD=0.40

# 置信度映射：confidence = (cosine + 1) / 2
# 该映射下 cosine=0.40 -> confidence=0.70，与上面的阈值严格对齐
FACE_CONFIDENCE_FLOOR=0.70

# 检索时返回的候选数量
FACE_MATCH_TOP_K=5

# 单张人脸最小像素（低于则丢弃，提升准确率）
FACE_MIN_SIZE=48
